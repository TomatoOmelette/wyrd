{
  "mcpServers": {
    "wyrd": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-v", "/absolute/path/to/wyrd/storage:/app/storage",
        "-v", "/absolute/path/to/wyrd/knowledge:/app/knowledge",
        "wyrd:latest",
        "serve",
        "--transport",
        "stdio"
      ]
    }
  }
}
